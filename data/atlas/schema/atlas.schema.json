{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bonsai/jazz-men/main/data/atlas/schema/atlas.schema.json",
  "title": "Music Atlas Dataset",
  "description": "JSON Schema for the canonical JSON/JSONL entity records used by THE SOUND LIBERATORS Music Atlas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artists",
    "places",
    "eras",
    "concepts",
    "works",
    "relations"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nullableYear": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "urlList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/url"
      },
      "uniqueItems": true
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "artist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "catalogue"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "catalogue": {
          "enum": [
            "world",
            "japan"
          ]
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "country_code",
        "latitude",
        "longitude",
        "precision",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "country",
            "region",
            "city",
            "scene",
            "venue"
          ]
        },
        "country_code": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "latitude": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "longitude": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "enum": [
            "exact",
            "approximate",
            "unknown"
          ]
        },
        "sources": {
          "$ref": "#/$defs/urlList"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "latitude": {
                "type": "null"
              }
            },
            "required": [
              "latitude"
            ]
          },
          "then": {
            "properties": {
              "longitude": {
                "type": "null"
              },
              "precision": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "longitude": {
                "type": "null"
              }
            },
            "required": [
              "longitude"
            ]
          },
          "then": {
            "properties": {
              "latitude": {
                "type": "null"
              },
              "precision": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "era": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "start_year",
        "end_year",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "start_year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "end_year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "description": {
          "type": "string"
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "label_ja",
        "category",
        "definition",
        "aliases",
        "sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "label_ja": {
          "type": "string"
        },
        "category": {
          "enum": [
            "genre",
            "practice",
            "technique",
            "philosophy",
            "scene",
            "sound"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sources": {
          "$ref": "#/$defs/urlList"
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "artist_ids",
        "release_year",
        "recording_year",
        "place_ids",
        "concept_ids",
        "source_urls"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "artist_ids": {
          "$ref": "#/$defs/idList"
        },
        "release_year": {
          "$ref": "#/$defs/nullableYear"
        },
        "recording_year": {
          "$ref": "#/$defs/nullableYear"
        },
        "place_ids": {
          "$ref": "#/$defs/idList"
        },
        "concept_ids": {
          "$ref": "#/$defs/idList"
        },
        "source_urls": {
          "$ref": "#/$defs/urlList"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "relation",
        "target",
        "evidence",
        "source_urls"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^(artist|work|place|concept|era):[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "relation": {
          "enum": [
            "associated_with",
            "influenced_by",
            "member_of",
            "performed_in",
            "based_in",
            "born_in",
            "recorded_in",
            "released_in_era",
            "uses_technique",
            "explores_concept"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^(artist|work|place|concept|era):[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "evidence": {
          "enum": [
            "source",
            "editorial"
          ]
        },
        "source_urls": {
          "$ref": "#/$defs/urlList"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "relation": {
                "const": "influenced_by"
              }
            },
            "required": [
              "relation"
            ]
          },
          "then": {
            "properties": {
              "evidence": {
                "const": "source"
              },
              "source_urls": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artists": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artist"
      },
      "uniqueItems": true
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      },
      "uniqueItems": true
    },
    "eras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/era"
      },
      "uniqueItems": true
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      },
      "uniqueItems": true
    },
    "works": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/work"
      },
      "uniqueItems": true
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    }
  }
}
